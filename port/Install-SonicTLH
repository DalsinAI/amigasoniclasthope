; $VER: Install-SonicTLH standalone-rc1 (5.11.2026)
; The Amiga Installer script for Sonic The Last Hope, an AmiCradle game port.
; Made by amicradle scripts/port_installer.py: change the spec, not this file.
; Run it from its icon, beside the SonicTLH drawer where the archive was unpacked.

(set @app-name "Sonic The Last Hope")
(set #version "standalone-rc1")
(set #drawer "SonicTLH")
(set #program "StartGame")
(set #space 292969)  ; KB

(onerror
    (message (cat "Sonic The Last Hope was not installed completely." "\n\n" @error-msg
                  "\n\nFiles already copied stay where they are. Run Install-SonicTLH again to finish.")))

; the Installer, the CPU and the FPU
(if (< @installer-version 2818051)
    (abort "Sonic The Last Hope needs Installer 43.3 or newer. This one is older: install AmigaOS 3.2 or a newer Installer."))
(set #cpu (database "cpu"))
(if (not (or (= #cpu "68040") (= #cpu "68060") (= #cpu "68080")))
    (abort (cat "Sonic The Last Hope needs a 68040, 68060 or 68080 with an FPU. This Amiga has a " #cpu ".")))
(if (= (database "fpu") "NOFPU")
    (abort "Sonic The Last Hope needs a 68040, 68060 or 68080 with an FPU. This Amiga has no FPU."))

; the package: the drawer beside this script
(set #source (pathonly (expandpath @icon)))
(set #from (tackon #source #drawer))
(if (<> (exists #from (noreq)) 2)
    (abort "The SonicTLH drawer is not beside Install-SonicTLH. Unpack the whole archive, then run Install-SonicTLH from there."))
(if (<> (exists (tackon #from #program) (noreq)) 1)
    (abort "The SonicTLH drawer has no StartGame in it. Unpack the whole archive again."))

(welcome "This installs Sonic The Last Hope standalone-rc1 for AmigaOS 3.2 on a 68040, 68060 or 68080 with an FPU.")

; where: the parent drawer
(set #default
    (if (= (exists "Work:Games" (noreq)) 2) "Work:Games"
        (if (= (exists "Work:" (noreq)) 2) "Work:" "SYS:")))
(set #parent
    (askdir
        (prompt "Where should the SonicTLH drawer go? Choose the drawer to put it in.")
        (help "The Installer makes or updates a drawer called SonicTLH in the drawer you choose. An update keeps your saves and settings.")
        (default #default)))
(set #dest (tackon #parent #drawer))
(set #update (= (exists #dest (noreq)) 2))
; in KB where the Installer can say so: in bytes, 2 GB free and more does not fit
(set #free (if (>= @installer-version 2883584) (getdiskspace #parent "K")
    (/ (getdiskspace #parent) 1024)))
(if (and (>= #free 0) (< #free #space))
    (abort (cat "There is not enough room in " #parent ": Sonic The Last Hope needs 300 MB free.")))

; GFOpenGPU's modules: in LIBS:GFOpenGPU/, or copied there from LIBS:OpenGPU/
; (older instances have only that); none is copied before all are found
(if (and (<> (exists "LIBS:GFOpenGPU/GL.module" (noreq)) 1) (<> (exists "LIBS:OpenGPU/GL.module" (noreq)) 1))
    (abort "Sonic The Last Hope needs GFOpenGPU's GL.module, which is in neither LIBS:GFOpenGPU/ nor LIBS:OpenGPU/. Install GFOpenGPU (SDL2) first, then run Install-SonicTLH again. Nothing has been installed."))
(if (and (<> (exists "LIBS:GFOpenGPU/SDL2.module" (noreq)) 1) (<> (exists "LIBS:OpenGPU/SDL2.module" (noreq)) 1))
    (abort "Sonic The Last Hope needs GFOpenGPU's SDL2.module, which is in neither LIBS:GFOpenGPU/ nor LIBS:OpenGPU/. Install GFOpenGPU (SDL2) first, then run Install-SonicTLH again. Nothing has been installed."))
(if (<> (exists "LIBS:GFOpenGPU" (noreq)) 2)
    (makedir "LIBS:GFOpenGPU"))
(if (<> (exists "LIBS:GFOpenGPU/GL.module" (noreq)) 1)
    (copylib
        (prompt "Copying GL.module from LIBS:OpenGPU/ to LIBS:GFOpenGPU/")
        (help @copylib-help)
        (source "LIBS:OpenGPU/GL.module")
        (dest "LIBS:GFOpenGPU")))
(if (<> (exists "LIBS:GFOpenGPU/SDL2.module" (noreq)) 1)
    (copylib
        (prompt "Copying SDL2.module from LIBS:OpenGPU/ to LIBS:GFOpenGPU/")
        (help @copylib-help)
        (source "LIBS:OpenGPU/SDL2.module")
        (dest "LIBS:GFOpenGPU")))
(complete 20)

; the drawer: everything in it, but what the player has made
(set #kept "")
(if (exists (tackon #dest "Game") (noreq))
    (set #kept (if (= #kept "") "Game" (cat #kept "|" "Game"))))
(if (exists (tackon #dest "game.zip") (noreq))
    (set #kept (if (= #kept "") "game.zip" (cat #kept "|" "game.zip"))))
(if (not #update)
    (makedir #dest))
(if (= #kept "")
    (copyfiles
        (prompt "Copying Sonic The Last Hope")
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (all)
        (optional "force" "askuser"))
    (copyfiles
        (prompt (cat "Updating Sonic The Last Hope. Kept as they are: " #kept))
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (pattern (cat "~(" #kept ")"))
        (optional "force" "askuser")))
(if (<> (exists (tackon #parent "SonicTLH.info") (noreq)) 1)
    (copyfiles
        (help @copyfiles-help)
        (source #source)
        (dest #parent)
        (choices "SonicTLH.info")))


; ---------------------------------------------------------------- the game's own files
; Sonic The Last Hope's own files are not in this archive: the player gives the Installer
; the archive or the folder they downloaded themselves, and the game drawer is
; built from it here, on this Amiga.
(set #root "Sonic The Last Hope")
(set #archive "Sonic The Last Hope.rar")
(set #archive-size 77299133)
(set #game (tackon #dest "Game"))
(set #gamezip (tackon #dest "game.zip"))
(set #have (or (= (exists (tackon #game "languages") (noreq)) 2) (= (exists #gamezip (noreq)) 1)))
(message "Sonic The Last Hope's own files are not part of this archive and are not given out with it. Download the game yourself from its page:\n\nhttps://sonicfangameshq.com/forums/showcase/sonic-the-last-hope.1543/\n\nThe file there is called Sonic The Last Hope.rar (77299133 bytes; SHA-256 eb0daac18a3762218dedad340528fb2ac7cf70548de1ac109bd78dda2d3bd391).")
(set #how
    (askchoice
        (prompt "Where are Sonic The Last Hope's own files, from Sonic The Last Hope.rar?")
        (help "The Installer copies the game's files into the Game drawer inside SonicTLH, beside the OpenSurge engine that comes with this archive. The archive is a RAR archive, which AmigaOS cannot unpack by itself: unpack it with UnRAR (Aminet) or on another computer, copy the Sonic The Last Hope folder to the Amiga, and choose that folder. prepare-amiga-port.sh (in the port's repository) makes a game.zip on another computer from the same download. Keep: leaves what an earlier run installed.")
        (choices "The folder I unpacked it into (called Sonic The Last Hope)" "A game.zip made by prepare-amiga-port.sh" "Keep the game files already installed")
        (default (if #have 2 0))))
(if (and (= #how 2) (not #have))
    (abort (cat "No game files are installed yet, so there is nothing to keep. Run Install-SonicTLH again and choose your download. The engine is installed in " #dest ".")))
(set #src "")
(if (= #how 0)
    (
        (set #src
            (askdir
                (prompt "Choose the folder called Sonic The Last Hope, unpacked from Sonic The Last Hope.rar.")
                (help @askdir-help)
                (default "RAM:")))
        (if (and (<> (fileonly #src) #root) (= (exists (tackon #src #root) (noreq)) 2))
            (set #src (tackon #src #root)))
        (if (<> (fileonly #src) #root)
            (abort (cat #src " is not the Sonic The Last Hope folder. Choose the folder that unpacking Sonic The Last Hope.rar made.")))
    )
)
(if (<> #src "")
    (
        (if (<> (exists (tackon #src "scripts/ui/menubuttonlist.ss") (noreq)) 1)
            (abort (cat #src " has no scripts/ui/menubuttonlist.ss. It is not a complete copy of Sonic The Last Hope.rar; unpack it again.")))
        (if (<> (getsize (tackon #src "scripts/ui/menubuttonlist.ss")) 6940)
            (abort (cat "scripts/ui/menubuttonlist.ss in " #src " is not the one in Sonic The Last Hope.rar (6940 bytes). Download the game again from https://sonicfangameshq.com/forums/showcase/sonic-the-last-hope.1543/")))
        (if (<> (exists (tackon #src "levels/base1.lev") (noreq)) 1)
            (abort (cat #src " has no levels/base1.lev. It is not a complete copy of Sonic The Last Hope.rar; unpack it again.")))
        (if (<> (getsize (tackon #src "levels/base1.lev")) 67138)
            (abort (cat "levels/base1.lev in " #src " is not the one in Sonic The Last Hope.rar (67138 bytes). Download the game again from https://sonicfangameshq.com/forums/showcase/sonic-the-last-hope.1543/")))
        (if (<> (exists (tackon #src "musics/neonice.ogg") (noreq)) 1)
            (abort (cat #src " has no musics/neonice.ogg. It is not a complete copy of Sonic The Last Hope.rar; unpack it again.")))
        (if (<> (getsize (tackon #src "musics/neonice.ogg")) 5541866)
            (abort (cat "musics/neonice.ogg in " #src " is not the one in Sonic The Last Hope.rar (5541866 bytes). Download the game again from https://sonicfangameshq.com/forums/showcase/sonic-the-last-hope.1543/")))
        (if (= (exists #gamezip (noreq)) 1)
            (delete #gamezip (optional "force")))
        (if (= (exists #game (noreq)) 2)
            (delete #game (all) (optional "force")))
        (copyfiles
            (prompt "Copying Sonic The Last Hope's files into the Game drawer")
            (help @copyfiles-help)
            (source #src)
            (dest #game)
            (pattern "~(#?.exe|#?.dll|src|screenshots|logfile.txt|allegro.log|surge.prefs|CMakeLists.txt|CHANGES.md|CONTRIBUTING.md|README.md)")
            (optional "force"))
        ; the game predates surge.cfg: add the port's (its title and screen size)
        (if (<> (exists (tackon #game "surge.cfg") (noreq)) 1)
            (copyfiles
                (help @copyfiles-help)
                (source (tackon #dest "Tools/surge.cfg"))
                (dest #game)
                (optional "force")))
        ; OpenSurge 0.6.1 asks for MenuButtonList to be declared an entity
        (if (<> @pretend 1)
            (
                (run "SYS:System/RexxMast >NIL:")
                (run "SYS:Rexxc/WaitForPort REXX")
                ; RX takes a quoted first word as a program's text, not its name: so
                ; the script is run from T:, whose name has no spaces in it
                (copyfiles (source (tackon #dest "Tools/PatchMenu.rexx")) (dest "T:") (optional "force"))
                (run (cat "SYS:Rexxc/RX T:PatchMenu.rexx \"" (tackon #game "scripts/ui/menubuttonlist.ss") "\""))
                (delete "T:PatchMenu.rexx" (optional "force"))
            )
        )
    )
)
(if (= #how 1)
    (
        (set #zip
            (askfile
                (prompt "Choose the game.zip that prepare-amiga-port.sh made from Sonic The Last Hope.rar.")
                (help @askfile-help)
                (default "RAM:")))
        (if (<> (exists #zip (noreq)) 1)
            (abort (cat "There is no file " #zip ".")))
        (if (= (exists #game (noreq)) 2)
            (delete #game (all) (optional "force")))
        (copyfiles
            (help @copyfiles-help)
            (source #zip)
            (dest #dest)
            (newname "game.zip")
            (optional "force"))
    )
)

(set @default-dest #dest)
(complete 100)
(if @pretend
    (message (cat "Pretend: nothing was copied or changed. Sonic The Last Hope would have gone in " #dest "."))
    (message (cat "Sonic The Last Hope standalone-rc1 is installed in " #dest "."
                  "\n\nTo start it, open the SonicTLH drawer and double-click the StartGame icon."
                  (if (= #kept "") "" (cat "\n\nLeft as they were: " #kept ".")))))
(exit (quiet))
